files:
  "/tmp/initialize-db.sh":
    mode: "000755"
    owner: webapp
    group: webapp
    content: |
      #!/bin/bash
      
      # Check if MySQL client is installed
      if ! command -v mysql &> /dev/null; then
        echo "MySQL client not installed. Installing..."
        yum install -y mysql
      fi
      
      # Get environment variables
      DB_HOST="${RDS_HOSTNAME}"
      DB_PORT="${RDS_PORT}"
      DB_NAME="${RDS_DB_NAME}"
      DB_USER="${RDS_USERNAME}"
      DB_PASS="${RDS_PASSWORD}"
      
      # Wait for MySQL to be available
      echo "Waiting for MySQL database to be available..."
      while ! mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p${DB_PASS} -e "SELECT 1" &> /dev/null; do
        sleep 5
      done
      
      # Check if database exists
      if ! mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p${DB_PASS} -e "USE ${DB_NAME}" &> /dev/null; then
        echo "Creating database ${DB_NAME}..."
        mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p${DB_PASS} -e "CREATE DATABASE IF NOT EXISTS ${DB_NAME}"
      else
        echo "Database ${DB_NAME} already exists."
      fi
      
      # Import the SQL file if it exists and the database is empty
      TABLE_COUNT=$(mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p${DB_PASS} -e "SELECT COUNT(TABLE_NAME) FROM information_schema.TABLES WHERE TABLE_SCHEMA = '${DB_NAME}'" --skip-column-names)
      
      if [ "$TABLE_COUNT" -eq "0" ]; then
        echo "Database is empty. Importing SQL file..."
        mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p${DB_PASS} ${DB_NAME} < /var/app/current/teashop.sql
        echo "Database initialized successfully."
      else
        echo "Database already contains tables. Skipping initialization."
      fi

container_commands:
  01_init_db:
    command: "/tmp/initialize-db.sh"
    leader_only: true